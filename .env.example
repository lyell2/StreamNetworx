# Copy to .env, then replace every empty/placeholder value locally.
# Generate random values with: openssl rand -hex 32

CLICKHOUSE_PASSWORD=
REDIS_PASSWORD=
MESH_INTERNAL_SECRET=
NATS_CLIENT_PASSWORD=
NATS_CLUSTER_PASSWORD=
ICECAST_SOURCE_PASS=
ICECAST_ADMIN_PASS=
HMAC_SECRET_KEY=
MANAGEMENT_API_KEY=

# Deployment identity. Keep one unique NODE_ID per VPS.
NODE_ID=sa-1-monitoring
WG_ADDRESS=10.10.0.1/24
WG_PORT=51820
PUBLIC_WG_ENDPOINT=
MESH_BOOTSTRAP_URL=
BOOTSTRAP_PEERS=
NATS_ROUTES=
